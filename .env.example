# Copy to .env.local for local development. .env.local is gitignored; this template is not.

# The absolute base URL of the deployed site, with no trailing slash.
#
# Everything derives from this single value: canonical URLs, hreflang alternates,
# the sitemap, robots.txt, and the Open Graph image base. Nothing in the codebase
# hardcodes a domain, so pointing the site at its real domain is one env var.
#
# The value below is an RFC 2606 .invalid placeholder, which is reserved and
# guaranteed never to resolve. That is deliberate: it makes local builds work and
# keeps every SEO assertion meaningful, while being obviously wrong if it ever
# escapes to production.
#
# IMPORTANT, two things about production:
#   1. src/lib/site.ts THROWS when VERCEL_ENV is 'production' and this is unset
#      or still .invalid. That is by design, so a real deploy cannot silently
#      publish placeholder canonicals.
#   2. NEXT_PUBLIC_* is inlined at BUILD time. Changing this in the Vercel
#      dashboard requires a redeploy, not just an env edit.
NEXT_PUBLIC_SITE_URL=https://veltrex.invalid

# Optional. Overrides the target of scripts/check-public-urls.mjs so the same
# assertions can be run against a Vercel preview deployment:
#   CHECK_BASE=https://veltrex-abc123.vercel.app node scripts/check-public-urls.mjs
# CHECK_BASE=
